# Aurora Swarm BTC Environment Variables
# Copy this file to .env and fill in your values

# === Redis (Control Plane) ===
REDIS_URL=redis://your-control-host:6379/0

# === Worker Configuration ===
WORKER_NAME=aurora-gpu1
GPUS_PER_POD=1
INTENSITY=19
MINING_WALLET=bc1qdpqzuem4dkamt8ckcwaul7a2rhqju30xwn3f5g
POOL_URL=stratum+tcp://stratum.braiins.com:3333

# === Optional ===
# AURORA_NODE_ID=worker-01   # Overrides WORKER_NAME for mesh registration
