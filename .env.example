# Aurora Swarm BTC Environment Variables
# Copy this file to .env and fill in your values

# === Redis (Control Plane) ===
REDIS_URL=redis://127.0.0.1:6379/0

# === Worker Configuration ===
WORKER_NAME=aurora-cpu1
GPUS_PER_POD=0
INTENSITY=19
MINING_WALLET=bc1qdpqzuem4dkamt8ckcwaul7a2rhqju30xwn3f5g
POOL_URL=stratum+tcp://stratum.braiins.com:3333

# === Node / mesh ===
# AURORA_NODE_ID=worker-01
AURORA_MINER_BACKEND=cpu
AURORA_AUTO_MINE=0
AURORA_DISCOVERY=1
AURORA_DISCOVERY_PORT=7379
# Same string on every LAN node — required for authentic discovery
# AURORA_MESH_SECRET=change-me-long-random
# AURORA_MESH_REQUIRE_AUTH=1
# Or pin the hub Redis explicitly:
# AURORA_MESH_REDIS=redis://192.168.1.10:6379/0

# === MetaField bridge (optional) ===
# METAFIELD_STATS_PATH=/tmp/metafield/stats.json
# METAFIELD_RUNTIME_DIR=/tmp/metafield
# METAFIELD_BRIDGE_PUBLISH=1
