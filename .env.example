# Aurora Swarm BTC Environment Variables
# Copy this file to .env and fill in your values

# === Redis (Control Plane) ===
REDIS_URL=redis://127.0.0.1:6379/0

# === Worker Configuration ===
WORKER_NAME=aurora-cpu1
GPUS_PER_POD=0
INTENSITY=19
MINING_WALLET=bc1qdpqzuem4dkamt8ckcwaul7a2rhqju30xwn3f5g
POOL_URL=stratum+tcp://stratum.braiins.com:3333

# === Node / mesh ===
AURORA_MINER_BACKEND=cpu
AURORA_AUTO_MINE=0
AURORA_DISCOVERY=1
AURORA_DISCOVERY_PORT=7379

# === Dashboard access control ===
# AURORA_DASHBOARD_API_KEY=

# === Destination routing / gateway ===
# AURORA_DESTINATION_ROUTING_ENABLED=0
# AURORA_GATEWAY_ADVERTISE_ENABLED=0
# AURORA_EGRESS_GATEWAY_ENABLED=0

# === HTTPS Viewer ===
# AURORA_HTTPS_VIEWER_ENABLED=1
# AURORA_VIEWER_MAX_SESSIONS=32
# AURORA_VIEWER_SESSION_TTL=600
# AURORA_VIEWER_PROXY_ENABLED=0
# AURORA_VIEWER_PROXY_BIND=127.0.0.1
# AURORA_VIEWER_PROXY_PORT=0
