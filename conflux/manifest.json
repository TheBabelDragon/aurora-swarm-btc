{
  "name": "conflux",
  "version": "0.1.1",
  "schema_id": "aurora.conflux",
  "description": "Agent-native source control, artifact lifecycle, and deployment coordination",
  "capabilities": [
    "project_registry",
    "git_source",
    "changesets",
    "reconciliation",
    "build_records",
    "immutable_releases",
    "dry_run_deployment",
    "evidence_bridge",
    "aegis_gated_mutations"
  ],
  "api_prefix": "/conflux",
  "control_plane_entity": "aurora.conflux",
  "safety": {
    "runner_default": "disabled",
    "deploy_default": "dry_run",
    "rewrites_history": false,
    "bitcoin_required": false,
    "aegis_required_default": true,
    "evidence_durable": false
  }
}
